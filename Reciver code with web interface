void handleRoot() {
  if (isAuthenticated) {
    server.sendHeader("Location", "/dashboard");
    server.send(303);
  } else {
    server.send(200, "text/html", HTML_LOGIN);
  }
}

void handleLogin() {
  if (server.method() == HTTP_POST) {
    String user = server.arg("username");
    String pass = server.arg("password");
    
    StaticJsonDocument<128> doc;
    
    if (user == web_username && pass == web_password) {
      isAuthenticated = true;
      sessionToken = String(millis());
      doc["success"] = true;
      doc["message"] = "Login successful";
    } else {
      doc["success"] = false;
      doc["message"] = "Invalid credentials";
    }
    
    String response;
    serializeJson(doc, response);
    server.send(200, "application/json", response);
  }
}

void handleDashboard() {
  if (!isAuthenticated) {
    server.sendHeader("Location", "/");
    server.send(303);
    return;
  }
  server.send(200, "text/html", HTML_DASHBOARD);
}

void handleLogout() {
  isAuthenticated = false;
  sessionToken = "";
  server.send(200, "text/plain", "OK");
}

void handleVehicleAPI() {
  if (!isAuthenticated) {
    server.send(401, "application/json", "{\"error\":\"Unauthorized\"}");
    return;
  }
  
  DynamicJsonDocument doc(4096);
  
  doc["vehicle_count"] = vehicle_count;
  
  double total_dist = 0;
  double total_rev = 0;
  
  JsonArray vehicles_array = doc.createNestedArray("vehicles");
  
  for (int i = 0; i < vehicle_count; i++) {
    JsonObject v = vehicles_array.createNestedObject();
    
    double dist_km = vehicles[i].total_distance_m / 1000.0;
    double fare = dist_km * RATE_PER_KM;
    
    total_dist += dist_km;
    total_rev += fare;
    
    v["id"] = vehicles[i].vehicle_id;
    v["fastag"] = vehicles[i].fastag;
    v["distance"] = dist_km;
    v["fare"] = String(fare, 2);
    
    unsigned long age_sec = (millis() - vehicles[i].last_update_ms) / 1000;
    v["time"] = String(age_sec) + "s ago";
  }
  
  doc["total_distance"] = total_dist;
  doc["total_revenue"] = total_rev;
  
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Wire.begin(4, 5);
  initOLED();
  displayWaiting();
  
  Serial.println("\n\n========================================");
  Serial.println("VEHICLE NH TRACKER - WEB SERVER");
  Serial.println("NodeMCU ESP8266 with ESP-NOW");
  Serial.println("========================================\n");
  
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  Serial.print("Connecting to WiFi");
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi Connected!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    Serial.print("Access Dashboard at: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWiFi Connection Failed!");
  }
  
  if (esp_now_init() != 0) {
    Serial.println("ESP-NOW init FAILED");
    return;
  }
  
  Serial.println("ESP-NOW >> Initialized");
  esp_now_set_self_role(ESP_NOW_ROLE_SLAVE);
  esp_now_register_recv_cb(onDataRecv);
  Serial.println("ESP-NOW >> Set as SLAVE, waiting for data...");
  
  server.on("/", handleRoot);
  server.on("/login", handleLogin);
  server.on("/dashboard", handleDashboard);
  server.on("/logout", handleLogout);
  server.on("/api/vehicles", handleVehicleAPI);
  
  server.begin();
  Serial.println("Web Server >> Started");
  
  Serial.println("\n========================================");
  Serial.println("SYSTEM READY");
  Serial.println("========================================\n");
  
  memset(vehicles, 0, sizeof(vehicles));
}

void loop() {
  server.handleClient();
  
  if (dstate.show_data && dstate.display_index >= 0) {
    if (millis() - dstate.display_time < 5000) {
      displayReceivedData(dstate.display_index);
    } else {
      dstate.show_data = false;
      dstate.display_index = -1;
      displayWaiting();
    }
  } else if (!dstate.show_data) {
    displayWaiting();
  }
  
  delay(10);
}
