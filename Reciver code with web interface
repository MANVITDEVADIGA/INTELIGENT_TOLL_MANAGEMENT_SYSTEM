#pragma pack(push,1)
struct TxPacket {
  char vehicle_id[16];
  char fastag[32];
  double total_distance_m;
  uint32_t seq;
};
#pragma pack(pop)

struct VehicleData {
  char vehicle_id[16];
  char fastag[32];
  double total_distance_m;
  uint32_t seq;
  unsigned long last_update_ms;
  bool is_active;
};

const int MAX_VEHICLES = 10;
VehicleData vehicles[MAX_VEHICLES];
int vehicle_count = 0;
const double RATE_PER_KM = 5.0;

const char* web_username = "admin";
const char* web_password = "admin123";

bool isAuthenticated = false;
String sessionToken = "";

struct DisplayState {
  bool show_data;
  unsigned long display_time;
  int display_index;
};
DisplayState dstate = {false, 0, -1};

void initOLED() {
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println("SSD1306 allocation failed");
    for(;;);
  }
  
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.clearDisplay();
  display.setCursor(10, 25);
  display.println("Vehicle Tracker");
  display.setCursor(20, 40);
  display.println("Initializing...");
  display.display();
  delay(2000);
}

void displayWaiting() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 10);
  display.println("Waiting for");
  display.setCursor(20, 35);
  display.println("Data...");
  display.setTextSize(1);
  display.setCursor(30, 58);
  display.println("Listening ESP-NOW");
  display.display();
}

void displayReceivedData(int idx) {
  if (idx < 0 || idx >= vehicle_count) return;
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  display.setCursor(0, 0);
  display.println("DATA RECEIVED!");
  
  display.drawLine(0, 9, 127, 9, SSD1306_WHITE);
  
  display.setCursor(0, 12);
  display.print("ID: ");
  display.println(vehicles[idx].vehicle_id);
  
  display.setCursor(0, 22);
  display.print("Distance: ");
  double dist_km = vehicles[idx].total_distance_m / 1000.0;
  display.print(dist_km, 2);
  display.println(" km");
  
  double fare = dist_km * RATE_PER_KM;
  display.setCursor(0, 32);
  display.print("Amount: ");
  display.print("Rs.");
  display.println(fare, 0);
  
  display.drawLine(0, 42, 127, 42, SSD1306_WHITE);
  
  display.setTextSize(1);
  display.setCursor(20, 48);
  display.println("TRANSACTION");
  display.setCursor(28, 58);
  display.println("SUCCESSFUL");
  
  display.display();
}

int findVehicle(const char* vehicle_id) {
  for (int i = 0; i < vehicle_count; i++) {
    if (strcmp(vehicles[i].vehicle_id, vehicle_id) == 0) {
      return i;
    }
  }
  return -1;
}

void updateVehicleData(const TxPacket &pkt) {
  int idx = findVehicle(pkt.vehicle_id);
  
  if (idx == -1) {
    if (vehicle_count < MAX_VEHICLES) {
      idx = vehicle_count;
      vehicle_count++;
      Serial.printf("NEW VEHICLE >> %s (Total: %d)\n", pkt.vehicle_id, vehicle_count);
    } else {
      Serial.println("MAX VEHICLES REACHED");
      return;
    }
  }
  
  strncpy(vehicles[idx].vehicle_id, pkt.vehicle_id, sizeof(vehicles[idx].vehicle_id)-1);
  vehicles[idx].vehicle_id[sizeof(vehicles[idx].vehicle_id)-1] = '\0';
  
  strncpy(vehicles[idx].fastag, pkt.fastag, sizeof(vehicles[idx].fastag)-1);
  vehicles[idx].fastag[sizeof(vehicles[idx].fastag)-1] = '\0';
  
  vehicles[idx].total_distance_m = pkt.total_distance_m;
  vehicles[idx].seq = pkt.seq;
  vehicles[idx].last_update_ms = millis();
  vehicles[idx].is_active = true;
  
  dstate.show_data = true;
  dstate.display_time = millis();
  dstate.display_index = idx;
  
  Serial.printf("UPDATE >> %s | Distance: %.2f km | Seq: %u\n", 
    pkt.vehicle_id, pkt.total_distance_m / 1000.0, pkt.seq);
}

void onDataRecv(uint8_t *mac, uint8_t *incomingData, uint8_t len) {
  if (len < (int)sizeof(TxPacket)) {
    Serial.printf("Invalid packet size: %d\n", len);
    return;
  }
  
  const TxPacket* pkt = (const TxPacket*)incomingData;
  updateVehicleData(*pkt);
}

